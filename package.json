{
  "name": "agent-work-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room local coding-agent control plane inspired by observable remote-agent workflows.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@typescript/typescript6": "6.0.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "scripts": {
    "product": "node scripts/product.mjs",
    "start:api": "node services/control-api/src/index.js",
    "start:daemon": "node runtime/daemon/src/index.js",
    "capability": "node scripts/capability.mjs",
    "repo:atlas": "node scripts/repo-atlas.mjs",
    "repo:atlas:mcp": "node scripts/repo-atlas-mcp.mjs",
    "test": "node --test services/control-api/test/*.test.js runtime/daemon/test/*.test.js packages/capability-fabric/test/*.test.js packages/repo-intelligence/test/*.test.js",
    "test:capabilities": "node --test packages/capability-fabric/test/*.test.js",
    "acceptance": "node scripts/acceptance.mjs && node --test services/control-api/integration/*.integration.js",
    "check": "npm test && npm run acceptance",
    "ship": "node scripts/ship.mjs run",
    "ship:validate": "node scripts/ship.mjs validate"
  }
}
