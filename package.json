{
  "name": "agent-work-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clean-room local coding-agent control plane inspired by observable remote-agent workflows.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start:api": "node services/control-api/src/integrated-index.js",
    "start:daemon": "node runtime/daemon/src/index.js",
    "mcp": "node services/mcp/src/index.js",
    "test": "node --test services/control-api/test/*.test.js services/mcp/test/*.test.js runtime/daemon/test/*.test.js packages/decision-memory/test/*.test.js",
    "acceptance": "node scripts/acceptance.mjs && node scripts/work-memory-acceptance.mjs && node scripts/work-handoff-acceptance.mjs",
    "check": "npm test && npm run acceptance",
    "memory": "node packages/decision-memory/src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  }
}
