      "slides_max": 10,
      "native_text": true,
      "native_shapes": true,
      "native_chart_min": 1,
      "native_table_min": 1,
      "speaker_notes": true,
      "accessibility_metadata": true
    }
  },
  "gates": {
    "research": [
      "donor_dossier_committed",
      "competitive_signals_recorded",
      "clean_room_boundary_committed"
    ],
    "specification": [
      "versioned_contracts_defined",
      "acceptance_tests_defined_before_implementation",
