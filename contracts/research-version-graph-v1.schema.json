{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-work-os.local/contracts/research-version-graph-v1.schema.json",
  "title": "Agent Work OS Research Version Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workspaceId", "roots", "heads", "snapshots", "graphSha256"],
  "properties": {
    "contractVersion": { "const": "research-version-graph/v1" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "roots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "heads": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshotId", "snapshotSha256", "parentSnapshotIds"],
        "properties": {
          "snapshotId": { "type": "string", "minLength": 1 },
          "snapshotSha256": { "$ref": "#/$defs/sha256" },
          "parentSnapshotIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "graphSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
