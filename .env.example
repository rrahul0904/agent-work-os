# Shared control-plane/daemon token. Replace outside local development.
AGENT_WORK_OS_TOKEN=dev-token

# Control plane
AGENT_WORK_OS_HOST=127.0.0.1
AGENT_WORK_OS_PORT=8787
AGENT_WORK_OS_STATE_PATH=.data/state.json

# Local daemon
AGENT_WORK_OS_SERVER_URL=ws://127.0.0.1:8787/ws
AGENT_WORK_OS_MACHINE_NAME=
AGENT_WORK_OS_ENABLE_ECHO=true
AGENT_WORK_OS_HEARTBEAT_MS=15000

# Optional Codex defaults
AGENT_WORK_OS_CODEX_MODEL=
AGENT_WORK_OS_CODEX_ARGS=[]
