# Legacy shared token for local development only.
AGENT_WORK_OS_TOKEN=dev-token
# Per-machine credential issued by an organization owner/admin for production daemons.
AGENT_WORK_OS_MACHINE_TOKEN=

# Hosted control plane (required in production)
DATABASE_URL=
AGENT_WORK_OS_ALLOWED_ORIGINS=
# Optional: Strict (default), Lax, or None. None requires production HTTPS.
AGENT_WORK_OS_COOKIE_SAME_SITE=Strict
# Enable only when a trusted ingress overwrites forwarded headers.
AGENT_WORK_OS_TRUST_PROXY=false

# Control plane
AGENT_WORK_OS_HOST=127.0.0.1
AGENT_WORK_OS_PORT=8787
# Hosted platforms such as Railway set PORT automatically; the server honors it before AGENT_WORK_OS_PORT.
AGENT_WORK_OS_STATE_PATH=.data/state.json
AGENT_WORK_OS_PORTFOLIO_PATH=config/portfolio.json
AGENT_WORK_OS_RECEIPTS_ROOT=receipts

# Local daemon
AGENT_WORK_OS_SERVER_URL=ws://127.0.0.1:8787/ws
AGENT_WORK_OS_MACHINE_NAME=
AGENT_WORK_OS_ENABLE_ECHO=true
AGENT_WORK_OS_HEARTBEAT_MS=15000
AGENT_WORK_OS_SHIPPING_STATE=.agent-work-os/shipping-state
AGENT_WORK_OS_COMMAND_TIMEOUT_MS=600000

# Governed local-machine tools (disabled unless roots + grants are set).
# Use the OS path delimiter for multiple roots (`:` on macOS/Linux, `;` on Windows).
AGENT_WORK_OS_WORKSPACE_ROOTS=
# Comma-separated subset of: read,write,execute
AGENT_WORK_OS_MACHINE_PERMISSIONS=
# Comma-separated executable names or absolute executable paths; no wildcard.
AGENT_WORK_OS_EXEC_ALLOW=
# Durable execution task state. Runner/spec/record/log files remain local to this machine.
AGENT_WORK_OS_MACHINE_TASKS_STATE=.agent-work-os/machine-tasks
AGENT_WORK_OS_MACHINE_TASK_MAX_MS=600000
AGENT_WORK_OS_MACHINE_TASK_LOG_BYTES=10485760

# Local MCP provider. The implementation enforces a loopback host; use Secure MCP Tunnel for supported remote clients.
AGENT_WORK_OS_MCP_HOST=127.0.0.1
AGENT_WORK_OS_MCP_PORT=8790
# Optional additional bearer check for direct/local MCP requests. Leave empty when the tunnel owns auth.
AGENT_WORK_OS_MCP_TOKEN=

# Optional Codex defaults
AGENT_WORK_OS_CODEX_MODEL=
AGENT_WORK_OS_CODEX_ARGS=[]
